# Copy to .env and fill in. Never commit .env.

# ---- Database (used by docker compose) ----
POSTGRES_USER=pomopal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pomopal
# Host ports, bound to 127.0.0.1 only. Change if 5432 or 3000 is already taken.
DB_PORT=5432
APP_PORT=3000

# Connection string for `npm run dev` on your machine (database from `docker compose up -d db`).
# Inside Docker the app builds its own URL with host "db", so this line is ignored there.
DATABASE_URL=postgres://pomopal:change-me@localhost:5432/pomopal

# ---- Better Auth ----
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# The public URL of the app: http://localhost:3000 locally, https://your-domain.com on the VPS
BETTER_AUTH_URL=http://localhost:3000

# ---- Google sign-in (optional, leave empty to disable) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
